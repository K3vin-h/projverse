// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//This is the schema for the postgresql database


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
//connecting to the db

//Authentication models required for next-auth is User, Account, Session, VerificationToken
//user model stores the user personal information, and calls the other models
model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  bio           String?
  github        String?
  website       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  projects  Project[]
  likes     Like[]
  comments  Comment[]
}

//account model stores the user account information, links user to OAuth providers and stores the OAuth tokens
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

//session model stores the user session information, stores session tokens and session expiry dates
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//verification token model stores the verification tokens, used for email verification(sign in) and password reset
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

//project model stores the project information, link the user who created the project, and stores likes and comments models
model Project {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  authorId    String
  repoUrl     String?
  demoUrl     String?
  docUrl      String?
  tags        String[]
  languages   String[]
  screenshots String[]
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes    Like[]
  comments Comment[]
}

//like model stores the like information, link the user who liked the project, and link the project that was liked
model Like {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}
//comment model stores the comment information, link the user who commented the project, and link the project that was commented
model Comment {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  content   String   @db.Text
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
